\
# RViz2 configuration file for fiducial_slam_ros2
Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1/Frames1
      Splitter Ratio: 0.5
    Tree Height: 413
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.588679016
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: "" # Cleared SyncSource as Image topic might not be directly available or named the same
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Marker Topic: /fiducials # Adjusted for ROS 2 topic name
      Name: Fiducials
      Namespaces:
        fiducial: true
        links: true
        sigma: true
        text: true
      Queue Size: 100
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15.0 # Float for ROS 2
      Frames:
        All Enabled: false
        base_footprint: # Changed from base_link to base_footprint to match common ROS 2 practice and declared param
          Value: true
        map:
          Value: true # Often good to see the map frame
        odom:
          Value: true
        # Add other frames as needed, e.g., camera_link if published
      Marker Scale: 1.0 # Float for ROS 2
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          odom:
            base_footprint: # Changed from base_link
              {}
            # camera_link: # Example if camera_link is child of base_footprint
            #   {}
      Update Interval: 0.0 # Float for ROS 2
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true # Assuming fiducial_images or similar topic will be available
      Image Topic: /fiducial_images # Check actual topic name in ROS 2
      Max Value: 1.0 # Float for ROS 2
      Median window: 5
      Min Value: 0.0 # Float for ROS 2
      Name: Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw # compressed might need a plugin or specific setup
      Unreliable: false
      Value: true
    - Alpha: 0.5
      Cell Size: 1.0 # Float for ROS 2
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164 # Standard RViz color format
      Enabled: true
      Line Style:
        Line Width: 0.03 # Float for ROS 2
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0.0 # Float for ROS 2
        Y: 0.0 # Float for ROS 2
        Z: 0.0 # Float for ROS 2
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    # LaserScan display - assuming /scan topic exists
    - Alpha: 1.0 # Float for ROS 2
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10.0 # Float for ROS 2
        Min Value: -10.0 # Float for ROS 2
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0.0 # Float for ROS 2
      Enabled: true # Set to false if no laser scanner
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096.0 # Adjusted, common max for some lidars
      Min Color: 0; 0; 0
      Min Intensity: 0.0 # Adjusted
      Name: LaserScan
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01 # Float for ROS 2
      Style: Flat Squares
      Topic: /scan # Standard topic for LaserScan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true # Set to false if no laser scanner
    # Path display - assuming /plan topic exists for navigation
    - Alpha: 1.0 # Float for ROS 2
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 0; 255 # Magenta
      Enabled: false # Set to true if path planning is used
      Head Diameter: 0.3 # Float for ROS 2
      Head Length: 0.2 # Float for ROS 2
      Length: 0.3 # Float for ROS 2
      Line Style: Lines
      Line Width: 0.03 # Float for ROS 2
      Name: Path
      Offset:
        X: 0.0 # Float for ROS 2
        Y: 0.0 # Float for ROS 2
        Z: 0.0 # Float for ROS 2
      Pose Style: None
      Radius: 0.03 # Float for ROS 2
      Shaft Diameter: 0.1 # Float for ROS 2
      Shaft Length: 0.1 # Float for ROS 2
      Topic: /plan # Standard topic for Path
      Unreliable: false
      Value: false # Set to true if path planning is used
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map # Default fixed frame
    Frame Rate: 30.0 # Float for ROS 2
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0 # Default color for measure tool
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose # Standard topic for initial pose
      StdDev: 0.5; 0.5; 0.261799387798 # x, y, theta std_devs
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose # Standard topic for goal pose in ROS 2 Nav2
      StdDev: 0.5; 0.5; 0.261799387798 # x, y, theta std_devs
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point # Standard topic for clicked point
  Value: true
  Views:
    Current:
      Angle: 0.0 # Float for ROS 2
      Class: rviz_default_plugins/Orbit # Changed from TopDownOrtho for more general use
      Distance: 10.0 # Example distance
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06 # Float for ROS 2
        Stereo Focal Distance: 1.0 # Float for ROS 2
        Swap Stereo Eyes: false
        Value: false
      Focal Point: # Added for Orbit view
        X: 0.0
        Y: 0.0
        Z: 0.0
      Name: Current View
      Near Clip Distance: 0.01 # Float for ROS 2
      Pitch: 0.785 # Example pitch (45 degrees)
      Target Frame: <Fixed Frame> # Default, can be changed
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.0 # Example Yaw
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1028
  Hide Left Dock: false
  Hide Right Dock: false
  Image: # Assuming an Image display panel might be used
    collapsed: false
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1855
  X: 65
  Y: 33
